# Copy to .env for docker compose; generate both secrets independently.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=crm.example.com
CSRF_TRUSTED_ORIGINS=https://crm.example.com
TRUST_PROXY_HTTPS=0

# Optional AI: valid model IDs for your API account; never commit real keys.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
AI_DAILY_LIMIT=20
